{
  "consumer": {
    "name": "order-client"
  },
  "interactions": [
    {
      "description": "a request for an unknown saga",
      "providerStates": [
        {
          "name": "no saga exists with the given id"
        }
      ],
      "request": {
        "matchingRules": {
          "path": {
            "combine": "AND",
            "matchers": [
              {
                "match": "regex",
                "regex": "\\/sagas\\/.+"
              }
            ]
          }
        },
        "method": "GET",
        "path": "/sagas/unknown-id"
      },
      "response": {
        "body": {
          "error": "saga not found"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.error": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/json.*"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request to create an order",
      "providerStates": [
        {
          "name": "the gateway accepts new orders"
        }
      ],
      "request": {
        "body": {
          "amount": 250
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "path": "/orders"
      },
      "response": {
        "body": {
          "orderId": "11111111-1111-1111-1111-111111111111",
          "sagaId": "22222222-2222-2222-2222-222222222222",
          "status": "pending"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        },
        "matchingRules": {
          "body": {
            "$.orderId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.sagaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/json.*"
                }
              ]
            }
          }
        },
        "status": 202
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "gateway"
  }
}